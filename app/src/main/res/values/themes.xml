<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch is always dark chrome (design system section 05, screen 01), so the
         pre-Compose window background matches that, not a light theme. The app
         draws edge-to-edge (MainActivity.enableEdgeToEdge), so bar colours are
         not set here; each screen pads itself by the system bar insets. -->
    <style name="Theme.GeoTagCamera" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/chrome_base</item>
        <item name="colorPrimary">@color/accent_verified</item>
    </style>
</resources>
