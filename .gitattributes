# LF everywhere, whatever core.autocrlf says. Text files packed into the APK
# (legal docs, Kotlin string literals) must be byte-identical on Windows and
# Linux checkouts, or the build is not reproducible.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
*.pdf binary
*.zip binary
